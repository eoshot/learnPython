# Copy this file to .env and fill in your values.

# Discord incoming webhook URL. Create one in Server Settings -> Integrations
# -> Webhooks -> New Webhook. Leave blank to disable Discord notifications
# (tracker will still log everything to history.db).
DISCORD_WEBHOOK_URL=

# How often (in minutes) you intend to invoke tracker.py via cron/launchd.
# The script itself enforces a minimum gap of 15 minutes between runs to
# avoid hammering Tesla's API; lower values here are clamped up.
POLL_INTERVAL_MINUTES=30
